{
  "name": "mds_cendekia",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "lint": "npm run lint:web && npm run lint:admin",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:admin": "npm --prefix apps/admin run lint",
    "lint:fix": "npm --prefix apps/web exec eslint . -- --fix && npm --prefix apps/admin exec eslint . -- --fix",
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "generate": "npm --prefix apps/web run generate",
    "preview": "npm --prefix apps/web run preview",
    "postinstall": "npm run prepare:web && npm run prepare:admin",
    "prepare:web": "npm --prefix apps/web run postinstall",
    "prepare:admin": "npm --prefix apps/admin run postinstall",
    "check": "npm run check:web && npm run check:admin",
    "check:web": "npm --prefix apps/web run check",
    "check:admin": "npm --prefix apps/admin run check"
  },
  "dependencies": {
    "@nuxtjs/google-fonts": "^3.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.5",
    "nuxt-security": "^2.5.1",
    "pdfjs-dist": "^5.7.284",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  }
}
